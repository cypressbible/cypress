---
/** Minimal geometric icons for discipleship pillars (no mountain imagery). */
export type PillarIconKey = "worship" | "community" | "proclaim" | "serve";

interface Props {
  variant: PillarIconKey;
}

const { variant } = Astro.props;
---

{variant === "worship" && (
  <svg
    class="pillar-icon-svg"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M10 30c0-8 6-14 14-14s14 6 14 14" />
    <path d="M14 30c0-5.5 4.5-10 10-10s10 4.5 10 10" />
    <path d="M18 30c0-3.3 2.7-6 6-6s6 2.7 6 6" />
    <circle cx="24" cy="30" r="2" fill="currentColor" stroke="none" />
  </svg>
)}

{variant === "community" && (
  <svg
    class="pillar-icon-svg"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="15" cy="19" r="5" />
    <circle cx="33" cy="19" r="5" />
    <path d="M9 38c0-6.6 5.4-11 15-11s15 4.4 15 11" />
    <path d="M24 26v6M21 29h6" />
  </svg>
)}

{variant === "proclaim" && (
  <svg
    class="pillar-icon-svg"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M10 17h11l14-5v26l-14-5H10z" />
    <path d="M35 21h6M38 18v10" />
    <circle cx="15.5" cy="24" r="2.5" fill="currentColor" stroke="none" />
  </svg>
)}

{variant === "serve" && (
  <svg
    class="pillar-icon-svg"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polygon points="24,9 35.5,15.5 35.5,28.5 24,35 12.5,28.5 12.5,15.5" />
    <path d="M17 24l5 5 11-11" />
  </svg>
)}
