---
export type PillarIconKey = "worship" | "community" | "proclaim" | "serve";

interface Props {
  variant: PillarIconKey;
}

const { variant } = Astro.props;

/** Font Awesome 6 Free — solid icons */
const iconClass: Record<PillarIconKey, string> = {
  worship: "fa-solid fa-music",
  community: "fa-solid fa-people-group",
  proclaim: "fa-solid fa-bullhorn",
  serve: "fa-solid fa-handshake-angle"
};
---

<i class={`${iconClass[variant]} pillar-fa`} aria-hidden="true"></i>
