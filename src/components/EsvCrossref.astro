---
/** Crossway ESV Cross-Reference Tool — linkifies references and shows ESV text on hover. https://www.esv.org/resources/esv-crossreference-tool/ */

const OPTIONS = {
  border_color: "334155",
  border_radius: 12,
  header_font_color: "f8fafc",
  body_font_color: "e2e8f0",
  footer_font_color: "94a3b8",
  header_background_color: "1e293b",
  body_background_color: "0f172a",
  footer_background_color: "152238",
  header_font_size: 15,
  body_font_size: 14,
  footer_font_size: 12,
  header_font_family: "Geist Sans",
  body_font_family: "Geist Sans",
  footer_font_family: "Geist Sans"
} as const;
---

<script is:inline define:vars={{ OPTIONS }}>
  window.ESV_CROSSREF_OPTIONS = OPTIONS;
</script>
<script is:inline defer src="https://static.esvapi.org/js/esv-crossref.min.js"></script>
