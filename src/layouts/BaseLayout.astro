---
import EsvCrossref from "../components/EsvCrossref.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import { getNextSerializedEvent } from "../lib/calendar";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cypress Bible",
  description = "Cypress Bible static site"
} = Astro.props as Props;

const nextCalendarEvent = await getNextSerializedEvent();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <SiteFooter nextEvent={nextCalendarEvent} />
    <EsvCrossref />
  </body>
</html>
