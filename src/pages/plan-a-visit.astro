---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}

const mapHref =
  "https://www.google.com/maps/place/11711+Cypress+North+Houston+Rd,+Cypress,+TX+77429/@29.9507516,-95.6001355,17z";

const mapEmbedSrc =
  "https://www.google.com/maps?q=11711+Cypress+North+Houston+Rd,+Cypress,+TX+77429&output=embed";

const img = (name: string) => `/images/plan-a-visit/${name}`;
---

<BaseLayout
  title="Plan a Sunday Morning Visit | Cypress Bible Church"
  description="Service times, directions, and what to expect when you visit Cypress Bible Church in Cypress, Texas."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <section class="plan-pav plan-pav--white" aria-label="Welcome">
    <div class="plan-pav-inner plan-pav-inner--wide">
      <h2 class="plan-pav-heading plan-pav-heading--navy">Welcome to Cypress Bible Church</h2>
      <div class="plan-pav-welcome-photos">
        <img src={img("welcome-1.webp")} width="360" height="360" alt="Guests at Cypress Bible Church" loading="eager" />
        <img src={img("welcome-2.webp")} width="360" height="360" alt="Congregation in the lobby" loading="eager" />
        <img src={img("welcome-3.webp")} width="360" height="360" alt="Fellowship at Cypress Bible Church" loading="lazy" />
      </div>

      <div class="plan-pav-service">
        <p class="plan-pav-service-kicker">Join us for service</p>
        <p class="plan-pav-service-times">Sunday at 9:30am &amp; 11:00am</p>
        <p class="plan-pav-service-note">Deaf Interpretation at 11am</p>
        <p class="plan-pav-service-btn-wrap">
          <a class="plan-pav-btn plan-pav-btn--slate" href="/livestream">
            Livestream Available 11AM
          </a>
        </p>
        <p class="plan-pav-address">
          <a href={mapHref}>11711 Cypress North Houston Rd, Cypress, TX 77429</a>
        </p>
      </div>
    </div>
  </section>

  <section class="plan-pav plan-pav--beige" aria-label="Kids ministry">
    <div class="plan-pav-inner plan-pav-inner--split">
      <div class="plan-pav-kids-copy">
        <h2 class="plan-pav-heading plan-pav-heading--navy">
          Cypress Bible Church Kids: Birth – 5th grade
        </h2>
        <p class="plan-pav-body plan-pav-body--navy">
          Please arrive around 15 minutes early to use our secure check-in process to drop your children off in their
          classes before the service. Once the service is over, you will be able to pick your children up from their
          classes by showing your child&apos;s unique check-in sticker.
        </p>
        <p>
          <a class="plan-pav-btn plan-pav-btn--navy" href="/checkin">Learn More</a>
        </p>
      </div>
      <div class="plan-pav-mosaic plan-pav-mosaic--kids" aria-hidden="true">
        <img class="plan-pav-kids-a" src={img("kids-4.webp")} width="400" height="225" alt="" loading="lazy" />
        <img class="plan-pav-kids-b" src={img("kids-3.webp")} width="400" height="267" alt="" loading="lazy" />
        <img class="plan-pav-kids-c" src={img("kids-1.webp")} width="500" height="700" alt="" loading="lazy" />
        <img class="plan-pav-kids-d" src={img("kids-2.webp")} width="400" height="267" alt="" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="plan-pav plan-pav--slate" aria-label="Student ministries">
    <div class="plan-pav-inner plan-pav-inner--split plan-pav-inner--students">
      <div class="plan-pav-mosaic plan-pav-mosaic--students" aria-hidden="true">
        <img class="plan-pav-stud-a" src={img("stud-1.webp")} width="600" height="400" alt="" loading="lazy" />
        <img class="plan-pav-stud-b" src={img("stud-2.webp")} width="400" height="400" alt="" loading="lazy" />
        <img class="plan-pav-stud-c" src={img("stud-3.webp")} width="400" height="400" alt="" loading="lazy" />
      </div>
      <div class="plan-pav-students-copy">
        <h2 class="plan-pav-heading plan-pav-heading--white">Student ministries</h2>
        <p class="plan-pav-body plan-pav-body--white">
          Our Middle and High School Ministry meets on Sunday Morning at 9:30am in the gym. They also meet on Wednesday
          evenings from 6pm – 8:30pm at the church in the gym.
        </p>
        <p>
          <a class="plan-pav-btn plan-pav-btn--navy" href="/students">
            Check out Student Ministries
          </a>
        </p>
      </div>
    </div>
  </section>

  <article class="plan-pav plan-pav--paper plan-visit-wrap">
    <h2>Frequently asked questions</h2>
    <p>
      Attending church for the first time can be an intimidating experience, especially if you don&apos;t know what to
      expect. We hope you will find that the central feature at Cypress Bible Church is the person of Jesus Christ.
    </p>

    <div class="plan-visit-faq">
      <details>
        <summary>Do I need to be a Christian to attend?</summary>
        <p>
          Absolutely not! We welcome anyone who is interested in exploring the claims of Jesus. All people are broken
          and in need of the healing of Christ, so we welcome anyone in any condition. We want everyone to come as they
          are; we want nobody to leave as they came.
        </p>
      </details>
      <details>
        <summary>What is the worship style?</summary>
        <p>
          We sing mostly contemporary Christian songs that are both singable and lyrically accurate. We also incorporate
          hymns that have been written for modern worship bands. Here&apos;s a{" "}
          <a
            href="https://open.spotify.com/playlist/1ynKxwQ5S8Ejh8Sg7FVzQ9"
            rel="noopener noreferrer"
            target="_blank">Spotify playlist</a
          >{" "}
          of some of the songs we sing.
        </p>
      </details>
      <details>
        <summary>How long are the services?</summary>
        <p>
          Services are typically 85 minutes long. Children&apos;s Ministry programming is available for both services.
        </p>
      </details>
      <details>
        <summary>Is the church accessible for people with disabilities?</summary>
        <p>
          Yes! We have wheelchair and handicap accessible restrooms as well as a thriving{" "}
          <a href="/specialneeds">special needs ministry</a> at Cypress Bible Church.
        </p>
      </details>
      <details>
        <summary>Is Cypress Bible Church part of a denomination?</summary>
        <p>Cypress Bible Church is a non-denominational church and is an elder-led church.</p>
      </details>
      <details>
        <summary>What is the dress code?</summary>
        <p>
          Just come dressed in a way that is comfortable for you. You will find anything from shorts to suit coats; jeans
          to dresses.
        </p>
      </details>
      <details>
        <summary>How often and who is allowed to take communion?</summary>
        <p>
          We hold communion on the 1st and 3rd Sundays of the month with bread or crackers (gluten free available) and
          grape juice. All believers are welcome to partake, but we ask those to abstain who do not profess faith in
          Jesus Christ or who knowingly have unrepentant hearts.
        </p>
      </details>
    </div>
  </article>

  <section class="plan-pav plan-pav--touch" aria-labelledby="plan-touch-title">
    <div class="plan-pav-touch-grid">
      <div class="plan-pav-touch-intro">
        <p class="plan-pav-touch-eyebrow">We are here to help</p>
        <h2 id="plan-touch-title" class="plan-pav-touch-title">Get in touch</h2>
        <p class="plan-pav-touch-lede">Answering your questions is important to us!</p>
      </div>
      <div class="plan-pav-touch-rows">
        <div class="plan-pav-touch-row">
          <span class="plan-pav-touch-icon" aria-hidden="true">
            <i class="fa-regular fa-envelope"></i>
          </span>
          <div>
            <div class="plan-pav-touch-label">Get in touch via email</div>
            <a class="plan-pav-touch-value" href="mailto:info@cypressbible.org">info@cypressbible.org</a>
          </div>
        </div>
        <div class="plan-pav-touch-row">
          <span class="plan-pav-touch-icon" aria-hidden="true">
            <i class="fa-solid fa-phone"></i>
          </span>
          <div>
            <div class="plan-pav-touch-label">Reach us by phone</div>
            <a class="plan-pav-touch-value" href="tel:+12814696063">(281) 469-6063</a>
          </div>
        </div>
        <div class="plan-pav-touch-row">
          <span class="plan-pav-touch-icon" aria-hidden="true">
            <i class="fa-solid fa-location-dot"></i>
          </span>
          <div>
            <div class="plan-pav-touch-label">Our church location</div>
            <a class="plan-pav-touch-value" href={mapHref}>
              11711 Cypress North Houston Rd, Cypress, TX 77429
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="plan-pav-touch-map">
      <iframe
        title="Cypress Bible Church on Google Maps"
        src={mapEmbedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </section>
</BaseLayout>
