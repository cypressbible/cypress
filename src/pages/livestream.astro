---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { getLiveStreamEmbedSrc, YOUTUBE_CHANNEL_URL } from "../data/livestream";
import { CHURCH_TZ } from "../lib/calendar-display";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}

const embedSrc = getLiveStreamEmbedSrc();
const tzLabel = new Intl.DateTimeFormat("en-US", {
  timeZone: CHURCH_TZ,
  timeZoneName: "shortGeneric"
})
  .formatToParts(new Date())
  .find((p) => p.type === "timeZoneName")?.value;

const timeZoneNote = tzLabel ? `${tzLabel} (${CHURCH_TZ})` : CHURCH_TZ;
---

<BaseLayout
  title="Sunday Livestream | Cypress Bible Church"
  description="Watch Cypress Bible Church Sunday services live on YouTube when streaming—same feed as our channel."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <a class="live-skip" href="#live-main">Skip to livestream player</a>

  <div class="live-page">
    <header class="live-hero" aria-labelledby="live-heading">
      <div class="live-hero-inner">
        <p class="live-hero-eyebrow">Media</p>
        <h1 id="live-heading" class="live-hero-title">Sunday livestream</h1>
        <p class="live-hero-lede">
          We stream our <strong>11:00&nbsp;AM</strong> Sunday service here and on our YouTube channel—helpful if you are
          traveling, under the weather, or getting to know us from a distance. Times are in {timeZoneNote}.
        </p>
      </div>
    </header>

    <div id="live-main" class="live-body">
      <div class="live-body-inner">
        <section class="live-panel" aria-label="Live video player">
          <div class="live-embed-wrap">
            <iframe
              class="live-embed-iframe"
              title="Cypress Bible Church on YouTube Live (when streaming)"
              src={embedSrc}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
          <p class="live-player-note">
            When we are live, the stream appears above. If you see a playback message instead, we are not currently
            broadcasting—open the service on <a href={YOUTUBE_CHANNEL_URL} rel="noopener noreferrer" target="_blank"
              >YouTube</a
            > where you can also subscribe for notifications.
          </p>
        </section>

        <aside class="live-aside" aria-label="Related links">
          <h2 class="live-aside-title">While you wait or after the service</h2>
          <ul class="live-aside-list">
            <li>
              <a href={YOUTUBE_CHANNEL_URL} rel="noopener noreferrer" target="_blank">
                <strong>YouTube channel</strong>
                <span class="live-aside-desc">Past messages, subscribe, and bell notifications</span>
              </a>
            </li>
            <li>
              <a href="/plan-a-visit">
                <strong>Plan a visit</strong>
                <span class="live-aside-desc">Service times and what to expect on campus</span>
              </a>
            </li>
            <li>
              <a href="/events">
                <strong>Calendar &amp; events</strong>
                <span class="live-aside-desc">Other upcoming gatherings</span>
              </a>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>
