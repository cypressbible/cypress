---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { churchContact, elders, ministryLeads, adminStaff } from "../data/leadership";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}
---

<BaseLayout
  title="Leadership & Staff | Cypress Bible Church"
  description="Elders, ministry leads, and administrative staff — names and ways to reach Cypress Bible Church."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <article class="staff-page">
    <div class="staff-page-inner">
    <header class="staff-page-head">
      <h1 class="staff-page-title">Leadership & Staff</h1>
      <p class="staff-page-sub">
        Main office contacts below. Listed emails match the CBC website where provided; otherwise reach the office first.
      </p>
      <dl class="staff-contact-row" aria-label="Church office">
        <div class="staff-contact-block">
          <dt>Address</dt>
          <dd>
            <a href={churchContact.mapHref}>{churchContact.addressLine}</a>
          </dd>
        </div>
        <div class="staff-contact-block">
          <dt>Phone</dt>
          <dd>
            <a href={`tel:${churchContact.phoneTel}`}>{churchContact.phoneDisplay}</a>
          </dd>
        </div>
        <div class="staff-contact-block">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${churchContact.email}`}>{churchContact.email}</a>
          </dd>
        </div>
      </dl>
    </header>

    <section class="staff-section" aria-labelledby="staff-elders">
      <h2 id="staff-elders" class="staff-heading">Elders</h2>
      <ul class="staff-grid">
        {
          elders.map((p) => (
            <li class="staff-card">
              <h3 class="staff-name">{p.name}</h3>
              <p class="staff-title">{p.title}</p>
              <p class="staff-email-line">
                {p.email ? (
                  <a class="staff-email-link" href={`mailto:${p.email}`}>
                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                    {p.email}
                  </a>
                ) : (
                  <a class="staff-email-link staff-email-link--fallback" href={`mailto:${churchContact.email}`}>
                    <span class="staff-email-muted">Via office:</span>
                    {churchContact.email}
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="staff-section" aria-labelledby="staff-ministry">
      <h2 id="staff-ministry" class="staff-heading">Ministry leads</h2>
      <ul class="staff-grid">
        {
          ministryLeads.map((p) => (
            <li class="staff-card">
              <h3 class="staff-name">{p.name}</h3>
              <p class="staff-title">{p.title}</p>
              <p class="staff-email-line">
                {p.email ? (
                  <a class="staff-email-link" href={`mailto:${p.email}`}>
                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                    {p.email}
                  </a>
                ) : (
                  <a class="staff-email-link staff-email-link--fallback" href={`mailto:${churchContact.email}`}>
                    <span class="staff-email-muted">Via office:</span>
                    {churchContact.email}
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="staff-section" aria-labelledby="staff-admin">
      <h2 id="staff-admin" class="staff-heading">Administrative staff</h2>
      <ul class="staff-grid">
        {
          adminStaff.map((p) => (
            <li class="staff-card">
              <h3 class="staff-name">{p.name}</h3>
              <p class="staff-title">{p.title}</p>
              <p class="staff-email-line">
                {p.email ? (
                  <a class="staff-email-link" href={`mailto:${p.email}`}>
                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                    {p.email}
                  </a>
                ) : (
                  <a class="staff-email-link staff-email-link--fallback" href={`mailto:${churchContact.email}`}>
                    <span class="staff-email-muted">Via office:</span>
                    {churchContact.email}
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="staff-footnote">
      Roster mirrored from{' '}
      <a href="https://cypressbible.org/leadership/">Cypress Bible Church — Leadership</a>.
    </p>
    </div>
  </article>
</BaseLayout>
