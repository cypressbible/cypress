---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import type { PillarIconKey } from "../components/PillarIcon.astro";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}

const slides = homePage.data.heroSlides;
const discipleshipPillars = homePage.data.discipleshipPillars;
const featuredStory = homePage.data.storiesFeatured;
const storyCards = homePage.data.storiesItems;

const pillarStockImages: Record<PillarIconKey, string> = {
  worship: "https://images.unsplash.com/photo-1528459801416-a9e53bbf4e17?auto=format&fit=crop&w=1000&q=80",
  community: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1000&q=80",
  proclaim: "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1000&q=80",
  serve: "https://images.unsplash.com/photo-1469571486292-b53601020ef5?auto=format&fit=crop&w=1000&q=80"
};

const marinersLoopSlides = [
  {
    title: "Follow Jesus",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1400&q=80"
  },
  {
    title: "Grow Together",
    image:
      "https://images.unsplash.com/photo-1529070538774-1843cb3265df?auto=format&fit=crop&w=1400&q=80"
  },
  {
    title: "Serve One Another",
    image:
      "https://images.unsplash.com/photo-1529390079861-591de354faf5?auto=format&fit=crop&w=1400&q=80"
  },
  {
    title: "Change The World",
    image:
      "https://images.unsplash.com/photo-1469571486292-b53601020ef5?auto=format&fit=crop&w=1400&q=80"
  }
];
---

<BaseLayout title={homePage.data.title} description={homePage.data.description}>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <section class="hero">
    <div class="rotator" data-rotator>
      {
        slides.map((slide, index) => (
          <article
            class={`slide ${index === 0 ? "is-active" : ""}`}
            data-slide
            style={slide.backgroundImage ? `--bg-image: url('${slide.backgroundImage}')` : ""}
          >
            <div class="overlay"></div>
            <div class="slide-content">
              <h1 class="slide-headline">
                {slide.title.includes("|") ? (
                  slide.title
                    .split("|")
                    .map((s) => s.trim())
                    .filter(Boolean)
                    .slice(0, 2)
                    .map((line) => <span class="slide-headline-line">{line}</span>)
                ) : (
                  slide.title
                )}
              </h1>
              <p>{slide.subtitle}</p>
              {slide.serviceTimes && <p class="slide-service-times">{slide.serviceTimes}</p>}
              <a class="hero-cta" href={slide.ctaHref}>
                {slide.ctaText}
              </a>
            </div>
          </article>
        ))
      }
      <div class="dot-nav" aria-label="Hero slide controls">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class={`dot ${index === 0 ? "is-active" : ""}`}
              data-dot={index}
              aria-label={`Show slide ${index + 1}`}
            ></button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sermon-widget-section" aria-label="Recent sermon">
    <div class="sermon-widget-wrap">
      <script src="https://bibleslides.app/embed/v1/widgets.js" defer></script>
      <bibleslides-recent-sermon
        church="cypressbible"
        api-base="https://bibleslides.app"
        surface="white"
        theme="light"
      ></bibleslides-recent-sermon>
    </div>
  </section>

  <section class="welcome-section" aria-labelledby="welcome-heading">
    <div class="welcome-inner">
      <div class="welcome-video" data-video-wrap>
        <video
          class="welcome-video-el"
          src={homePage.data.welcomeVideoSrc}
          playsinline
          preload="metadata"
        >
        </video>
        <button type="button" class="welcome-play" aria-label="Play welcome video">
          <span class="welcome-play-icon" aria-hidden="true"></span>
        </button>
        <p class="welcome-video-error" role="alert">
          This video could not be loaded. Try refreshing the page, or use a current version of Chrome,
          Safari, or Firefox.
        </p>
      </div>
      <div class="welcome-copy">
        <p class="welcome-eyebrow">{homePage.data.welcomeEyebrow}</p>
        <h2 id="welcome-heading" class="welcome-title">{homePage.data.welcomeTitle}</h2>
        <p class="welcome-body">{homePage.data.welcomeBody}</p>
        <a class="welcome-cta" href={homePage.data.welcomeCtaHref}>{homePage.data.welcomeCtaText}</a>
      </div>
    </div>
  </section>

  <section class="discipleship-section" aria-labelledby="discipleship-heading">
    <div class="discipleship-inner">
      <div class="discipleship-intro">
        <h2 id="discipleship-heading" class="discipleship-heading">
          {homePage.data.discipleshipHeading}
        </h2>
        <p class="discipleship-lede">{homePage.data.discipleshipIntro}</p>
      </div>
      <div class="discipleship-rotator" data-pillars-rotator>
        {
          discipleshipPillars.map((pillar, index) => (
            <article
              class={`discipleship-pillar ${index === 0 ? "is-active" : ""}`}
              data-pillar-slide={index}
              id={`pillar-panel-${index}`}
              role="tabpanel"
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div
                class="pillar-hero"
                style={`--pillar-image: url('${pillarStockImages[pillar.iconKey as PillarIconKey]}')`}
              >
                <div class="pillar-hero-overlay"></div>
                <div class="pillar-hero-content">
                  <h3 class="pillar-title">{pillar.title}</h3>
                  <p class="pillar-body">{pillar.body}</p>
                </div>
              </div>
            </article>
          ))
        }
        <div class="pillar-nav" role="tablist" aria-label="Discipleship pillar controls">
          {
            discipleshipPillars.map((pillar, index) => (
              <button
                type="button"
                role="tab"
                class={`pillar-nav-btn ${index === 0 ? "is-active" : ""}`}
                data-pillar-tab={index}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`pillar-panel-${index}`}
              >
                <span class="pillar-nav-badge">{pillar.badge}</span>
              </button>
            ))
          }
        </div>
        <div class="pillar-progress" aria-hidden="true">
          <span class="pillar-progress-bar" data-pillar-progress></span>
        </div>
      </div>
    </div>
  </section>

  <section class="loop-experiment-section" aria-labelledby="loop-experiment-heading">
    <div class="loop-experiment-inner">
      <div class="loop-visual" data-loop-rotator style="--loop-angle: -90deg;">
        <div class="loop-frame">
          {
            marinersLoopSlides.map((slide, index) => (
              <article
                class={`loop-slide ${index === 0 ? "is-active" : ""}`}
                data-loop-slide
                data-loop-title={slide.title}
                style={`--loop-image: url('${slide.image}')`}
                aria-hidden={index === 0 ? "false" : "true"}
              ></article>
            ))
          }

          <div class="loop-orbit" aria-hidden="true">
            <span class="loop-orbit-node loop-orbit-node--top"></span>
            <span class="loop-orbit-node loop-orbit-node--right"></span>
            <span class="loop-orbit-node loop-orbit-node--bottom"></span>
            <span class="loop-orbit-node loop-orbit-node--left"></span>
            <span class="loop-orbit-dot"></span>
          </div>

          <div class="loop-center">
            <h3 class="loop-center-title" data-loop-title>{marinersLoopSlides[0].title}</h3>
          </div>
        </div>

        <div class="loop-controls" role="tablist" aria-label="Transformational loop slides">
          {
            marinersLoopSlides.map((slide, index) => (
              <button
                type="button"
                role="tab"
                class={`loop-control ${index === 0 ? "is-active" : ""}`}
                data-loop-control={index}
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`Show ${slide.title}`}
              ></button>
            ))
          }
        </div>
      </div>

      <div class="loop-copy">
        <h2 id="loop-experiment-heading" class="loop-copy-heading">Get Involved</h2>
        <p class="loop-copy-body">
          At Mariners, we refer to the discipleship journey as the Transformational Loop - becoming
          more like Jesus as we grow in faith. We want to help you Follow Jesus with your life, Grow
          Together in community, Serve One Another with your unique gifts, and Change the World with
          the love of Christ. If you're ready to take your next step of faith, we are here to help.
        </p>
        <a class="loop-copy-cta" href="/plan-a-visit">Experience The Loop</a>
      </div>
    </div>
  </section>

  <section class="stories-section" aria-labelledby="stories-heading">
    <div class="stories-inner">
      <h2 id="stories-heading" class="stories-heading">{homePage.data.storiesHeading}</h2>

      <div class="stories-featured">
        <div class="stories-featured-copy">
          <p class="stories-eyebrow">{featuredStory.eyebrow}</p>
          <blockquote class="stories-quote">{featuredStory.quote}</blockquote>
          <a class="stories-cta" href={featuredStory.ctaHref}>
            {featuredStory.ctaText}
          </a>
        </div>

        <a class="stories-media stories-media--featured" href={featuredStory.storyHref}>
          <img src={featuredStory.imageSrc} alt={featuredStory.imageAlt} loading="lazy" />
          <span class="stories-play">
            <span class="stories-play-icon" aria-hidden="true"></span>
            <span>{featuredStory.watchLabel}</span>
          </span>
        </a>
      </div>

      <div class="stories-grid">
        {
          storyCards.map((story) => (
            <article class="stories-card">
              <a class="stories-media" href={story.storyHref}>
                <img src={story.imageSrc} alt={story.imageAlt} loading="lazy" />
                <span class="stories-play">
                  <span class="stories-play-icon" aria-hidden="true"></span>
                  <span>{story.watchLabel}</span>
                </span>
              </a>
              <p class="stories-card-quote">{story.quote}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
  const rotator = document.querySelector("[data-rotator]");
  if (rotator) {
    const slides = Array.from(rotator.querySelectorAll("[data-slide]"));
    const dots = Array.from(rotator.querySelectorAll("[data-dot]"));
    let activeIndex = 0;
    let timer;

    const showSlide = (index) => {
      activeIndex = index;
      slides.forEach((slide, i) => slide.classList.toggle("is-active", i === activeIndex));
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === activeIndex));
    };

    const startAutoplay = () => {
      if (slides.length < 2) return;
      timer = window.setInterval(() => {
        const next = (activeIndex + 1) % slides.length;
        showSlide(next);
      }, 5500);
    };

    const restartAutoplay = () => {
      if (timer) window.clearInterval(timer);
      startAutoplay();
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showSlide(index);
        restartAutoplay();
      });
    });

    startAutoplay();
  }

  document.querySelectorAll("[data-video-wrap]").forEach((wrap) => {
    const video = wrap.querySelector("video");
    const btn = wrap.querySelector(".welcome-play");
    if (!video || !btn || !(btn instanceof HTMLButtonElement)) return;

    video.addEventListener("error", () => {
      wrap.classList.add("has-error");
    });

    btn.addEventListener("click", async () => {
      wrap.classList.add("is-playing");
      video.setAttribute("controls", "");

      const tryPlay = async (muted) => {
        video.muted = muted;
        await video.play();
      };

      try {
        await tryPlay(false);
        btn.hidden = true;
      } catch {
        try {
          await tryPlay(true);
          btn.hidden = true;
        } catch {
          wrap.classList.remove("is-playing");
          video.removeAttribute("controls");
          video.muted = false;
        }
      }
    });

    video.addEventListener("ended", () => {
      btn.hidden = false;
      wrap.classList.remove("is-playing");
      video.removeAttribute("controls");
      video.muted = false;
    });
  });

  document.querySelectorAll("[data-pillars-rotator]").forEach((rotator) => {
    const slides = Array.from(rotator.querySelectorAll("[data-pillar-slide]"));
    const tabs = Array.from(rotator.querySelectorAll("[data-pillar-tab]"));
    const progressBar = rotator.querySelector("[data-pillar-progress]");
    if (!slides.length || !tabs.length) return;

    let activeIndex = 0;
    let timer;
    const autoplayMs = 4800;

    const restartProgress = () => {
      if (!(progressBar instanceof HTMLElement)) return;
      progressBar.style.animation = "none";
      progressBar.getBoundingClientRect();
      progressBar.style.animation = `pillar-progress ${autoplayMs}ms linear forwards`;
    };

    const showPillar = (index) => {
      activeIndex = index;

      slides.forEach((slide, i) => {
        const isActive = i === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      tabs.forEach((tab, i) => {
        const isActive = i === activeIndex;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
      });

      restartProgress();
    };

    const startAutoplay = () => {
      if (slides.length < 2) return;
      if (timer) return;
      timer = window.setInterval(() => {
        const next = (activeIndex + 1) % slides.length;
        showPillar(next);
      }, autoplayMs);
    };

    const stopAutoplay = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const restartAutoplay = () => {
      stopAutoplay();
      startAutoplay();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        showPillar(index);
        restartAutoplay();
      });

      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const step = event.key === "ArrowRight" ? 1 : -1;
        const next = (index + step + tabs.length) % tabs.length;
        const target = tabs[next];
        if (!(target instanceof HTMLButtonElement)) return;
        showPillar(next);
        target.focus();
        restartAutoplay();
      });
    });

    rotator.addEventListener("mouseenter", () => {
      stopAutoplay();
      if (progressBar instanceof HTMLElement) {
        progressBar.style.animationPlayState = "paused";
      }
    });
    rotator.addEventListener("mouseleave", () => {
      startAutoplay();
      if (progressBar instanceof HTMLElement) {
        progressBar.style.animationPlayState = "running";
      }
    });
    rotator.addEventListener("focusin", () => {
      stopAutoplay();
      if (progressBar instanceof HTMLElement) {
        progressBar.style.animationPlayState = "paused";
      }
    });
    rotator.addEventListener("focusout", (event) => {
      const destination = event.relatedTarget;
      if (!(destination instanceof HTMLElement) || !rotator.contains(destination)) {
        startAutoplay();
        if (progressBar instanceof HTMLElement) {
          progressBar.style.animationPlayState = "running";
        }
      }
    });

    showPillar(0);
    startAutoplay();
  });

  document.querySelectorAll("[data-loop-rotator]").forEach((rotator) => {
    const slides = Array.from(rotator.querySelectorAll("[data-loop-slide]"));
    const controls = Array.from(rotator.querySelectorAll("[data-loop-control]"));
    const title = rotator.querySelector("[data-loop-title]");
    if (!slides.length) return;

    let activeIndex = 0;
    let timer;
    const autoplayMs = 4600;
    const step = 360 / slides.length;

    const showLoopSlide = (index) => {
      activeIndex = index;
      const angle = activeIndex * step - 90;
      rotator.style.setProperty("--loop-angle", `${angle}deg`);

      slides.forEach((slide, i) => {
        const isActive = i === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      controls.forEach((control, i) => {
        const isActive = i === activeIndex;
        control.classList.toggle("is-active", isActive);
        control.setAttribute("aria-selected", String(isActive));
      });

      const activeSlide = slides[activeIndex];
      if (title instanceof HTMLElement && activeSlide instanceof HTMLElement) {
        title.textContent = activeSlide.dataset.loopTitle || "";
      }
    };

    const startAutoplay = () => {
      if (slides.length < 2 || timer) return;
      timer = window.setInterval(() => {
        showLoopSlide((activeIndex + 1) % slides.length);
      }, autoplayMs);
    };

    const stopAutoplay = () => {
      if (!timer) return;
      window.clearInterval(timer);
      timer = undefined;
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => {
        showLoopSlide(index);
        stopAutoplay();
        startAutoplay();
      });
    });

    rotator.addEventListener("mouseenter", stopAutoplay);
    rotator.addEventListener("mouseleave", startAutoplay);

    showLoopSlide(0);
    startAutoplay();
  });
  </script>
</BaseLayout>
