---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { discipleshipPillarPages } from "../data/discipleship-pillars";
import SpotlightRotator from "../components/SpotlightRotator.astro";
import { resolveSpotlightSlides, spotlightSectionEyebrow } from "../data/spotlight-events";
import { loadCalendarEvents } from "../lib/calendar";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}

const slides = homePage.data.heroSlides;
const featuredStory = homePage.data.storiesFeatured;
const storyCards = homePage.data.storiesItems;
const marinersLoopSlides = discipleshipPillarPages;
const calendarEvents = await loadCalendarEvents();
const spotlightSlides = resolveSpotlightSlides(calendarEvents);
---

<BaseLayout title={homePage.data.title} description={homePage.data.description}>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <div class="home-hero">
  <section class="hero" aria-label="Homepage highlights">
    <div class="rotator" data-rotator>
      {
        slides.map((slide, index) => (
          <article
            class={`slide ${index === 0 ? "is-active" : ""}`}
            data-slide
            style={slide.backgroundImage ? `--bg-image: url('${slide.backgroundImage}')` : ""}
          >
            <div class="overlay"></div>
            <div class="slide-content">
              <h1 class="slide-headline">
                {slide.title.includes("|") ? (
                  slide.title
                    .split("|")
                    .map((s) => s.trim())
                    .filter(Boolean)
                    .slice(0, 2)
                    .map((line) => <span class="slide-headline-line">{line}</span>)
                ) : (
                  slide.title
                )}
              </h1>
              <p>{slide.subtitle}</p>
              {slide.serviceTimes && <p class="slide-service-times">{slide.serviceTimes}</p>}
              <a class="hero-cta" href={slide.ctaHref}>
                {slide.ctaText}
              </a>
            </div>
          </article>
        ))
      }
      <div class="dot-nav" aria-label="Hero slide controls">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class={`dot ${index === 0 ? "is-active" : ""}`}
              data-dot={index}
              aria-label={`Show slide ${index + 1}`}
            ></button>
          ))
        }
      </div>
    </div>
  </section>

  <section class="welcome-section hero-welcome" aria-labelledby="welcome-heading">
    <div class="welcome-inner">
      <div class="welcome-video" data-video-wrap>
        <video
          class="welcome-video-el"
          src={homePage.data.welcomeVideoSrc}
          poster={homePage.data.welcomeVideoPoster}
          playsinline
          preload="metadata"
        >
        </video>
        <button type="button" class="welcome-play" aria-label="Play welcome video">
          <span class="welcome-play-icon" aria-hidden="true"></span>
        </button>
        <p class="welcome-video-error" role="alert">
          This video could not be loaded. Try refreshing the page, or use a current version of Chrome,
          Safari, or Firefox.
        </p>
      </div>
      <div class="welcome-copy">
        <p class="welcome-eyebrow">{homePage.data.welcomeEyebrow}</p>
        <h2 id="welcome-heading" class="welcome-title">{homePage.data.welcomeTitle}</h2>
        <p class="welcome-body">{homePage.data.welcomeBody}</p>
        <a class="welcome-cta" href={homePage.data.welcomeCtaHref}>{homePage.data.welcomeCtaText}</a>
      </div>
    </div>
  </section>
  </div>

  <SpotlightRotator slides={spotlightSlides} eyebrow={spotlightSectionEyebrow} />

  <section class="sermon-widget-section bibleslides-embed-bleed" aria-label="Recent sermon">
    <script src="https://bibleslides.app/embed/v1/widgets.js" defer></script>
    <bibleslides-recent-sermon
      church="cypressbible"
      variant="header"
      service="Sunday Morning"
      api-base="https://bibleslides.app"
      surface="white"
      theme="light"
      font-family="inherit"
    ></bibleslides-recent-sermon>
  </section>

  <section id="get-involved-loop" class="loop-experiment-section" aria-labelledby="loop-experiment-heading">
    <div class="loop-experiment-inner">
      <div class="loop-visual" data-loop-rotator style="--loop-angle: -90deg;">
        <a class="loop-frame-link" data-loop-link href={`/pillars/${marinersLoopSlides[0].slug}`}>
          <div class="loop-frame">
          {
            marinersLoopSlides.map((slide, index) => (
              <article
                class:list={[
                  "loop-slide",
                  index === 0 && "is-active",
                  !slide.image?.trim() && "loop-slide--no-image",
                ]}
                data-loop-slide
                data-loop-title={slide.title}
                data-loop-slug={slide.slug}
                data-loop-icon={slide.icon}
                data-loop-color={slide.color}
                data-loop-summary={slide.summary}
                style={slide.image?.trim() ? `--loop-image: url('${slide.image}')` : undefined}
                aria-hidden={index === 0 ? "false" : "true"}
              ></article>
            ))
          }

          <div class="loop-orbit" aria-hidden="true">
            <span class="loop-orbit-node loop-orbit-node--top is-active" data-loop-node="0"></span>
            <span class="loop-orbit-node loop-orbit-node--right" data-loop-node="1"></span>
            <span class="loop-orbit-node loop-orbit-node--bottom" data-loop-node="2"></span>
            <span class="loop-orbit-node loop-orbit-node--left" data-loop-node="3"></span>
          </div>

          <div class="loop-center">
            <i
              class={`loop-center-icon fa-solid ${marinersLoopSlides[0].icon}`}
              data-loop-center-icon
              style={`color: ${marinersLoopSlides[0].color}`}
              aria-hidden="true"
            ></i>
            <h3 class="loop-center-title" data-loop-center-title>{marinersLoopSlides[0].title}</h3>
          </div>
          </div>
        </a>

        <div class="loop-controls-row">
          <button type="button" class="loop-nav-icon" data-loop-prev aria-label="Previous pillar">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <div class="loop-controls" role="tablist" aria-label="Transformational loop slides">
            {
              marinersLoopSlides.map((slide, index) => (
                <button
                  type="button"
                  role="tab"
                  class={`loop-control ${index === 0 ? "is-active" : ""}`}
                  data-loop-control={index}
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-label={`Show ${slide.title}`}
                ></button>
              ))
            }
          </div>
          <button type="button" class="loop-nav-icon" data-loop-next aria-label="Next pillar">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div class="loop-copy">
        <h2 id="loop-experiment-heading" class="loop-copy-heading">Four Pillars Of Growth</h2>
        <p class="loop-copy-body">
          Growing into a disciple of Christ is a lifelong process. Four pillars of discipleship
          support our spiritual growth at CBC.
        </p>
        <a class="loop-copy-cta" href={`/pillars/${marinersLoopSlides[0].slug}`} data-loop-cta>
          {marinersLoopSlides[0].title}
        </a>
        <p class="loop-copy-support" data-loop-support>{marinersLoopSlides[0].summary}</p>
      </div>
    </div>
  </section>

  <section class="stories-section" aria-labelledby="stories-heading">
    <div class="stories-inner">
      <h2 id="stories-heading" class="stories-heading">{homePage.data.storiesHeading}</h2>

      <div class="stories-featured">
        <div class="stories-featured-copy">
          <p class="stories-eyebrow">{featuredStory.eyebrow}</p>
          <blockquote class="stories-quote">{featuredStory.quote}</blockquote>
          <a class="stories-cta" href={featuredStory.ctaHref}>
            {featuredStory.ctaText}
          </a>
        </div>

        <a class="stories-media stories-media--featured" href={featuredStory.storyHref}>
          <img src={featuredStory.imageSrc} alt={featuredStory.imageAlt} loading="lazy" />
          <span class="stories-play">
            <span class="stories-play-icon" aria-hidden="true"></span>
            <span>{featuredStory.watchLabel}</span>
          </span>
        </a>
      </div>

      <div class="stories-grid">
        {
          storyCards.map((story) => (
            <article class="stories-card">
              <a class="stories-media" href={story.storyHref}>
                <img src={story.imageSrc} alt={story.imageAlt} loading="lazy" />
                <span class="stories-play">
                  <span class="stories-play-icon" aria-hidden="true"></span>
                  <span>{story.watchLabel}</span>
                </span>
              </a>
              <p class="stories-card-quote">{story.quote}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
  const rotator = document.querySelector("[data-rotator]");
  if (rotator) {
    const slides = Array.from(rotator.querySelectorAll("[data-slide]"));
    const dots = Array.from(rotator.querySelectorAll("[data-dot]"));
    let activeIndex = 0;
    let timer;

    const showSlide = (index) => {
      activeIndex = index;
      slides.forEach((slide, i) => slide.classList.toggle("is-active", i === activeIndex));
      dots.forEach((dot, i) => dot.classList.toggle("is-active", i === activeIndex));
    };

    const startAutoplay = () => {
      if (slides.length < 2) return;
      timer = window.setInterval(() => {
        const next = (activeIndex + 1) % slides.length;
        showSlide(next);
      }, 5500);
    };

    const restartAutoplay = () => {
      if (timer) window.clearInterval(timer);
      startAutoplay();
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showSlide(index);
        restartAutoplay();
      });
    });

    startAutoplay();
  }

  document.querySelectorAll("[data-video-wrap]").forEach((wrap) => {
    const video = wrap.querySelector("video");
    const btn = wrap.querySelector(".welcome-play");
    if (!video || !btn || !(btn instanceof HTMLButtonElement)) return;

    video.addEventListener("error", () => {
      wrap.classList.add("has-error");
    });

    const hidePlayButton = () => {
      wrap.classList.add("is-playing");
      btn.hidden = true;
    };

    const showPlayButton = () => {
      wrap.classList.remove("is-playing");
      btn.hidden = false;
    };

    btn.addEventListener("click", async () => {
      hidePlayButton();
      video.setAttribute("controls", "");

      const tryPlay = async (muted) => {
        video.muted = muted;
        await video.play();
      };

      try {
        await tryPlay(false);
      } catch {
        try {
          await tryPlay(true);
        } catch {
          showPlayButton();
          video.removeAttribute("controls");
          video.muted = false;
        }
      }
    });

    video.addEventListener("play", hidePlayButton);

    video.addEventListener("ended", () => {
      showPlayButton();
      video.removeAttribute("controls");
      video.muted = false;
    });
  });

  document.querySelectorAll("[data-loop-rotator]").forEach((rotator) => {
    const slides = Array.from(rotator.querySelectorAll("[data-loop-slide]"));
    const controls = Array.from(rotator.querySelectorAll("[data-loop-control]"));
    const orbitNodes = Array.from(rotator.querySelectorAll("[data-loop-node]"));
    const title = rotator.querySelector("[data-loop-center-title]");
    const icon = rotator.querySelector("[data-loop-center-icon]");
    const prevButton = rotator.querySelector("[data-loop-prev]");
    const nextButton = rotator.querySelector("[data-loop-next]");
    const deepLink = rotator.querySelector("[data-loop-link]");
    const cta = document.querySelector("[data-loop-cta]");
    const support = document.querySelector("[data-loop-support]");
    if (!slides.length) return;

    let activeIndex = 0;
    let timer;
    const autoplayMs = 3910;
    const step = 360 / slides.length;

    const showLoopSlide = (index) => {
      activeIndex = index;
      const angle = activeIndex * step - 90;
      rotator.style.setProperty("--loop-angle", `${angle}deg`);

      slides.forEach((slide, i) => {
        const isActive = i === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      controls.forEach((control, i) => {
        const isActive = i === activeIndex;
        control.classList.toggle("is-active", isActive);
        control.setAttribute("aria-selected", String(isActive));
      });

      orbitNodes.forEach((node, i) => {
        node.classList.toggle("is-active", i === activeIndex);
      });

      const activeSlide = slides[activeIndex];
      if (title instanceof HTMLElement && activeSlide instanceof HTMLElement) {
        title.textContent = activeSlide.dataset.loopTitle || "";
      }

      if (icon instanceof HTMLElement && activeSlide instanceof HTMLElement) {
        icon.className = `loop-center-icon fa-solid ${activeSlide.dataset.loopIcon || "fa-circle"}`;
        icon.style.color = activeSlide.dataset.loopColor || "#334155";
      }

      const slug = activeSlide instanceof HTMLElement ? activeSlide.dataset.loopSlug : undefined;
      const summary = activeSlide instanceof HTMLElement ? activeSlide.dataset.loopSummary : undefined;
      const href = slug ? `/pillars/${slug}` : "/plan-a-visit";

      if (deepLink instanceof HTMLAnchorElement) {
        deepLink.href = href;
      }

      if (cta instanceof HTMLAnchorElement) {
        cta.href = href;
        cta.textContent = activeSlide instanceof HTMLElement ? activeSlide.dataset.loopTitle || "Take a Step" : "Take a Step";
      }

      if (support instanceof HTMLElement && summary) {
        support.textContent = summary;
      }
    };

    const startAutoplay = () => {
      if (slides.length < 2 || timer) return;
      timer = window.setInterval(() => {
        showLoopSlide((activeIndex + 1) % slides.length);
      }, autoplayMs);
    };

    const stopAutoplay = () => {
      if (!timer) return;
      window.clearInterval(timer);
      timer = undefined;
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => {
        showLoopSlide(index);
        stopAutoplay();
        startAutoplay();
      });
    });

    if (prevButton instanceof HTMLButtonElement) {
      prevButton.addEventListener("click", () => {
        showLoopSlide((activeIndex - 1 + slides.length) % slides.length);
        stopAutoplay();
        startAutoplay();
      });
    }

    if (nextButton instanceof HTMLButtonElement) {
      nextButton.addEventListener("click", () => {
        showLoopSlide((activeIndex + 1) % slides.length);
        stopAutoplay();
        startAutoplay();
      });
    }

    rotator.addEventListener("mouseenter", stopAutoplay);
    rotator.addEventListener("mouseleave", startAutoplay);

    showLoopSlide(0);
    startAutoplay();
  });
  </script>
</BaseLayout>
