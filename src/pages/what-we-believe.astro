---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import {
  beliefComparisonIntro,
  DOCTRINAL_STATEMENT_PDF,
  doctrineSections,
  ordinancePhilosophy,
  statementOfFaithIntro,
  statementOfFaithRows
} from "../data/what-we-believe";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}
---

<BaseLayout
  title="What We Believe | Cypress Bible Church"
  description="Compare our membership statement of faith with the full doctrinal statement and communion philosophy—all rooted in Scripture."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <a class="belief-skip" href="#belief-main">Skip to belief content</a>

  <div id="belief-main" class="belief-shell">
    <header class="belief-page-head">
      <h1 class="belief-page-title">What we believe</h1>
    </header>

    <div class="belief-tablist" data-belief-tabs role="tablist" aria-label="Statement of faith or doctrinal statement">
      <button
        type="button"
        id="belief-tab-sof"
        class="belief-tab belief-tab--active"
        role="tab"
        aria-selected="true"
        aria-controls="belief-pane-sof"
        tabindex="0"
        data-belief-tab="sof">Statement of faith</button>
      <button
        type="button"
        id="belief-tab-doctrine"
        class="belief-tab"
        role="tab"
        aria-selected="false"
        aria-controls="belief-pane-doctrine"
        tabindex="-1"
        data-belief-tab="doctrine">Doctrinal statement</button>
    </div>

    <p class="belief-compare-intro">{beliefComparisonIntro}</p>

    <section
      id="belief-pane-sof"
      role="tabpanel"
      aria-labelledby="belief-tab-sof"
      class="belief-pane"
      data-belief-pane="sof"
    >
      <h2 class="belief-panel-h2">Statement of faith</h2>
      <p class="belief-sof-intro">{statementOfFaithIntro}</p>

      <div class="belief-details-stack">
        {
          statementOfFaithRows.map((row, index) => (
            <div class="belief-acc-item">
              {
                row.videoUrl && (
                  <div class="belief-video-row">
                    <a
                      class="belief-video-link"
                      href={row.videoUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <i class="fa-solid fa-circle-play belief-video-icon" aria-hidden="true" />
                      <span>Watch teaching video</span>
                    </a>
                  </div>
                )
              }
              <details id={row.id} class="belief-details belief-details--sof">
                <summary>
                  <span class="belief-sof-num" aria-hidden="true">
                    {index + 1}
                  </span>
                  <span class="belief-details-sof-heading">{row.title}</span>
                </summary>
                <div class="belief-details-body">
                  <p>{row.body}</p>
                  <p class="belief-refs">
                    <strong>References:</strong>
                    {" "}{row.references}
                  </p>
                </div>
              </details>
            </div>
          ))
        }
      </div>
    </section>

    <section
      id="belief-pane-doctrine"
      role="tabpanel"
      aria-labelledby="belief-tab-doctrine"
      class="belief-pane belief-pane--doctrine"
      data-belief-pane="doctrine"
      hidden
    >
      <h2 class="belief-panel-h2">Doctrinal statement</h2>
      <p class="belief-doc-lede">
        Twelve theological headings—all who preach and teach are expected to align with these convictions. Open any
        heading for the full wording we use publicly.
      </p>
      <p class="belief-pdf-banner belief-pdf-banner--pane">
        <a class="belief-pdf-link" href={DOCTRINAL_STATEMENT_PDF} rel="noopener noreferrer" target="_blank">
          <i class="fa-solid fa-file-pdf" aria-hidden="true" />
          Download the official doctrinal statement (PDF)
        </a>
      </p>
      <p class="belief-scan-hint">
        Each heading matches our published doctrinal statement; Scripture citations follow the prose.
      </p>

      <div class="belief-details-stack">
        {
          doctrineSections.map((d) => (
            <div class="belief-acc-item">
              {
                d.videoUrl && (
                  <div class="belief-video-row">
                    <a
                      class="belief-video-link"
                      href={d.videoUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <i class="fa-solid fa-circle-play belief-video-icon" aria-hidden="true" />
                      <span>Watch teaching video</span>
                    </a>
                  </div>
                )
              }
              <details id={d.id} class="belief-details">
                <summary>
                  <span class="belief-details-label">{d.label}</span>
                  <span class="belief-details-title">{d.title}</span>
                </summary>
                <div class="belief-details-body">
                  <p>{d.teaching}</p>
                  <p class="belief-refs">
                    <strong>References:</strong>
                    {" "}{d.references}
                  </p>
                </div>
              </details>
            </div>
          ))
        }
      </div>

      <section class="belief-panel-section" id="ordinance-philosophy" aria-labelledby="ord-heading">
        <h3 id="ord-heading" class="belief-section-title">
          Philosophy of communion <span class="belief-section-muted">ordinance practice at CBC</span>
        </h3>
        <p class="belief-scan-hint belief-scan-hint--tight">
          How we approach the Lord’s Supper—purpose, practice, and boundaries—stated as affirmations and denials.
        </p>
        {
          ordinancePhilosophy.map((topic) =>
            topic.closing && !topic.intro && (!topic.pairs || topic.pairs.length === 0) ? (
              <aside class="belief-ord-sum" aria-labelledby={`${topic.id}-title`}>
                <h4 id={`${topic.id}-title`} class="belief-ord-sum-title">
                  {topic.heading}
                </h4>
                <p class="belief-ord-closing">{topic.closing}</p>
              </aside>
            ) : (
              <details class="belief-details belief-details--sub" id={topic.id}>
                <summary>{topic.heading}</summary>
                <div class="belief-details-body">
                  {topic.intro && <p class="belief-ord-intro">{topic.intro}</p>}
                  {topic.pairs?.map((pair) => (
                    <div class="belief-ad-grid">
                      <p class="belief-ad belief-ad--yes">
                        <span class="belief-ad-tag">Affirm</span>
                        {pair.affirm}
                      </p>
                      <p class="belief-ad belief-ad--no">
                        <span class="belief-ad-tag">Deny</span>
                        {pair.deny}
                      </p>
                    </div>
                  ))}
                </div>
              </details>
            )
          )
        }
      </section>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var tabWrap = document.querySelector("[data-belief-tabs]");
    if (!tabWrap) return;
    var tabs = tabWrap.querySelectorAll('[role="tab"]');
    var panes = {
      sof: document.querySelector('[data-belief-pane="sof"]'),
      doctrine: document.querySelector('[data-belief-pane="doctrine"]')
    };

    function setTab(key) {
      for (var i = 0; i < tabs.length; i++) {
        var t = tabs[i];
        var sel = t.getAttribute("data-belief-tab") === key;
        t.setAttribute("aria-selected", sel ? "true" : "false");
        t.classList.toggle("belief-tab--active", sel);
        t.setAttribute("tabindex", sel ? "0" : "-1");
      }
      if (panes.sof) panes.sof.hidden = key !== "sof";
      if (panes.doctrine) panes.doctrine.hidden = key !== "doctrine";
    }

    tabWrap.addEventListener("click", function (ev) {
      var btn = ev.target.closest('[role="tab"]');
      if (!btn || !tabWrap.contains(btn)) return;
      var key = btn.getAttribute("data-belief-tab");
      if (key) setTab(key);
    });
  })();
</script>
