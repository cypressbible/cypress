---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import {
  beliefComparisonIntro,
  DOCTRINAL_STATEMENT_PDF,
  doctrineSections,
  getYoutubeEmbedSrc,
  getYoutubeThumbnailSrc,
  statementOfFaithIntro,
  statementOfFaithRows
} from "../data/what-we-believe";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}
---

<BaseLayout
  title="What We Believe | Cypress Bible Church"
  description="Compare our membership statement of faith with the full doctrinal statement—both rooted in Scripture, with teaching videos for each doctrinal heading."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <a class="belief-skip" href="#belief-main">Skip to belief content</a>

  <div id="belief-main" class="belief-shell">
    <header class="belief-page-head">
      <h1 class="belief-page-title">What we believe</h1>
    </header>

    <div class="belief-intro-dual belief-choice-tablist" data-belief-tabs role="tablist" aria-label="Statement of faith or doctrinal statement">
      <button
        type="button"
        id="belief-tab-sof"
        class="belief-choice-card belief-card belief-card--soft belief-tab belief-tab--active"
        role="tab"
        aria-selected="true"
        aria-controls="belief-pane-sof"
        tabindex="0"
        data-belief-tab="sof"
      >
        <div class="belief-card-icon" aria-hidden="true">
          <i class="fa-solid fa-book-open"></i>
        </div>
        <h2 class="belief-choice-title">Statement of faith</h2>
        <p class="belief-choice-lede">
          Seven doctrinal pillars every CBC member affirms—the portable backbone of our unity.
        </p>
      </button>
      <button
        type="button"
        id="belief-tab-doctrine"
        class="belief-choice-card belief-card belief-card--strong belief-tab"
        role="tab"
        aria-selected="false"
        aria-controls="belief-pane-doctrine"
        tabindex="-1"
        data-belief-tab="doctrine"
      >
        <div class="belief-card-icon belief-card-icon--light" aria-hidden="true">
          <i class="fa-solid fa-scale-balanced"></i>
        </div>
        <h2 class="belief-choice-title">Doctrinal statement</h2>
        <p class="belief-choice-lede">
          Twelve theological headings—all who preach and teach align with these convictions.
        </p>
      </button>
    </div>

    <p class="belief-compare-intro">{beliefComparisonIntro}</p>

    <section
      id="belief-pane-sof"
      role="tabpanel"
      aria-labelledby="belief-tab-sof"
      class="belief-pane belief-pane--sof"
      data-belief-pane="sof"
    >
      <h2 class="belief-panel-h2">Statement of faith</h2>
      <p class="belief-sof-intro">{statementOfFaithIntro}</p>

      <div class="belief-details-stack">
        {
          statementOfFaithRows.map((row, index) => (
            <div class="belief-acc-item">
              {
                row.videoUrl && (
                  <div class="belief-video-row">
                    <a
                      class="belief-video-link"
                      href={row.videoUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <i class="fa-solid fa-circle-play belief-video-icon" aria-hidden="true" />
                      <span>Watch teaching video</span>
                    </a>
                  </div>
                )
              }
              <details id={row.id} class="belief-details belief-details--sof">
                <summary>
                  <span class="belief-sof-num" aria-hidden="true">
                    {index + 1}
                  </span>
                  <span class="belief-details-sof-heading">{row.title}</span>
                </summary>
                <div class="belief-details-body">
                  <p>{row.body}</p>
                  <p class="belief-refs">
                    <strong>References:</strong>
                    {" "}{row.references}
                  </p>
                </div>
              </details>
            </div>
          ))
        }
      </div>
    </section>

    <section
      id="belief-pane-doctrine"
      role="tabpanel"
      aria-labelledby="belief-tab-doctrine"
      class="belief-pane belief-pane--doctrine"
      data-belief-pane="doctrine"
      hidden
    >
      <h2 class="belief-panel-h2">Doctrinal statement</h2>
      <p class="belief-doc-lede">
        Twelve theological headings—all who preach and teach are expected to align with these convictions. Open any
        heading for the full wording we use publicly.
      </p>
      <p class="belief-pdf-banner belief-pdf-banner--pane">
        <a class="belief-pdf-link" href={DOCTRINAL_STATEMENT_PDF} rel="noopener noreferrer" target="_blank">
          <i class="fa-solid fa-file-pdf" aria-hidden="true" />
          Download the official doctrinal statement (PDF)
        </a>
      </p>
      <p class="belief-scan-hint">
        Each heading matches our published doctrinal statement; Scripture citations follow the prose. Open a heading for the full text; use the row link or the thumbnail below to watch the matching teaching video from our legacy What We Believe page.
      </p>

      <div class="belief-details-stack">
        {
          doctrineSections.map((d) => {
            const embedSrc = getYoutubeEmbedSrc(d.videoUrl);
            const thumbSrc = getYoutubeThumbnailSrc(d.videoUrl);

            return (
              <details id={d.id} class="belief-details belief-details--doctrine">
                <summary>
                  <span class="belief-summary-main">
                    <span class="belief-details-label">{d.label}</span>
                    <span class="belief-details-title">{d.title}</span>
                  </span>
                  <a
                    class="belief-summary-video-link belief-video-link"
                    href={d.videoUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    onclick="event.stopPropagation()"
                  >
                    <i class="fa-solid fa-circle-play belief-video-icon" aria-hidden="true" />
                    <span>Watch video</span>
                  </a>
                  <span class="belief-details-expand" aria-hidden="true"></span>
                </summary>
                <div class="belief-details-body">
                  <p>{d.teaching}</p>
                  <p class="belief-refs">
                    <strong>References:</strong>
                    {" "}{d.references}
                  </p>
                  {embedSrc && thumbSrc ? (
                    <div class="belief-youtube-facade" data-belief-youtube-facade data-embed-src={embedSrc}>
                      <button type="button" class="belief-youtube-poster" aria-label={`Play embedded video: ${d.title}`}>
                        <img src={thumbSrc} alt="" width={480} height={360} loading="lazy" decoding="async" />
                        <span class="belief-youtube-play-badge" aria-hidden="true">
                          <i class="fa-solid fa-circle-play"></i>
                        </span>
                      </button>
                      <div class="belief-youtube-frame-wrap" hidden>
                        <iframe
                          class="belief-youtube-iframe"
                          title={`YouTube: ${d.title}`}
                          loading="lazy"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          referrerpolicy="strict-origin-when-cross-origin"
                          allowfullscreen
                        />
                      </div>
                    </div>
                  ) : null}
                </div>
              </details>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var tabWrap = document.querySelector("[data-belief-tabs]");
    if (tabWrap) {
      var tabs = tabWrap.querySelectorAll('[role="tab"]');
      var panes = {
        sof: document.querySelector('[data-belief-pane="sof"]'),
        doctrine: document.querySelector('[data-belief-pane="doctrine"]')
      };

      function setTab(key) {
        for (var i = 0; i < tabs.length; i++) {
          var t = tabs[i];
          var sel = t.getAttribute("data-belief-tab") === key;
          t.setAttribute("aria-selected", sel ? "true" : "false");
          t.classList.toggle("belief-tab--active", sel);
          t.setAttribute("tabindex", sel ? "0" : "-1");
        }
        if (panes.sof) panes.sof.hidden = key !== "sof";
        if (panes.doctrine) panes.doctrine.hidden = key !== "doctrine";
      }

      tabWrap.addEventListener("click", function (ev) {
        var btn = ev.target.closest('[role="tab"]');
        if (!btn || !tabWrap.contains(btn)) return;
        var key = btn.getAttribute("data-belief-tab");
        if (key) setTab(key);
      });
    }

    document.querySelectorAll("[data-belief-youtube-facade]").forEach(function (wrap) {
      var poster = wrap.querySelector(".belief-youtube-poster");
      var frameWrap = wrap.querySelector(".belief-youtube-frame-wrap");
      var iframe = wrap.querySelector(".belief-youtube-iframe");
      var baseSrc = wrap.getAttribute("data-embed-src");
      if (!poster || !frameWrap || !iframe || !baseSrc) return;
      poster.addEventListener("click", function () {
        var sep = baseSrc.indexOf("?") >= 0 ? "&" : "?";
        iframe.src = baseSrc + sep + "autoplay=1";
        frameWrap.hidden = false;
        poster.hidden = true;
      });
    });
  })();
</script>
