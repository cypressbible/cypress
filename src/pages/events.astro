---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import EventsMonthCalendar from "../components/EventsMonthCalendar.astro";
import { getCollection } from "astro:content";
import { getUpcomingSerializedEvents, loadCalendarEvents } from "../lib/calendar";
import { CHURCH_CALENDAR_WEB_URL } from "../config/calendar-embed";
import { formatEventRange, CHURCH_TZ } from "../lib/calendar-display";

const pages = await getCollection("pages");
const homePage = pages.find((entry) => entry.id === "home.md" || entry.id === "home");

if (!homePage) {
  throw new Error("Missing content entry: src/content/pages/home.md");
}

const eventsList = await getUpcomingSerializedEvents(48);
const allCalendarEvents = await loadCalendarEvents();

const heroSlides = [
  {
    image:
      "https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1800&q=80",
    alt: "Worship gathering at church"
  },
  {
    image:
      "https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&w=1800&q=80",
    alt: "Church community fellowship"
  },
  {
    image:
      "https://images.unsplash.com/photo-1504052434569-70ad5836ab65?auto=format&fit=crop&w=1800&q=80",
    alt: "People serving together at church"
  }
];

function excerpt(text: string | undefined, max = 220): string {
  if (!text) return "";
  const flat = text.replace(/\s+/g, " ").trim();
  return flat.length <= max ? flat : `${flat.slice(0, max - 1)}…`;
}
---

<BaseLayout
  title="Events & Calendar | Cypress Bible Church"
  description="See what is coming up at Cypress Bible Church—gatherings, rhythms, and room to plan ahead."
>
  <SiteHeader menuItems={homePage.data.menuItems} currentPath={Astro.url.pathname} />

  <div class="events-page">
    <header class="events-hero">
      <div class="events-hero-rotator rotator" data-rotator>
        {
          heroSlides.map((slide, index) => (
            <article
              class:list={["slide", "events-hero-slide", index === 0 && "is-active"]}
              data-slide
              style={`--bg-image: url('${slide.image}')`}
            >
              <div class="overlay" aria-hidden="true" />
              <div class="events-hero-inner">
                <p class="events-hero-eyebrow">Plan ahead</p>
                <h1 class="events-hero-title">Upcoming Events</h1>
                <p class="events-hero-lede">
                  Times shown in Central Time (<span class="events-tz">{CHURCH_TZ}</span>). Browse the list below or use the
                  month view for the full schedule from our Church Community Builder calendar.
                </p>
              </div>
            </article>
          ))
        }
        <div class="dot-nav" aria-label="Events hero slide controls">
          {
            heroSlides.map((_, index) => (
              <button
                type="button"
                class:list={["dot", index === 0 && "is-active"]}
                data-dot={index}
                aria-label={`Show slide ${index + 1}`}
              />
            ))
          }
        </div>
      </div>
    </header>

    <section class="events-body" aria-label="Events list">
      <div class="events-body-inner">
        {
          eventsList.length === 0 ? (
            <div class="events-empty-panel">
              <p class="events-empty-title">Calendar could not load this build</p>
              <p class="events-empty-body">
                The schedule is normally read from Cypress Bible&apos;s subscription calendar at build time. If this
                message appears, confirm the ICS feed still responds—or set <code class="events-empty-code">CALENDAR_ICAL_URL</code> explicitly (use <code class="events-empty-code">https://…</code> or <code class="events-empty-code">webcal://…</code>).
              </p>
              <p class="events-empty-body">
                <a href="#full-calendar">Jump to month calendar →</a>
              </p>
            </div>
          ) : (
            <ul class="events-cards">
              {eventsList.map((ev) => (
                <li class="events-card">
                  <div class="events-card-date" aria-hidden="true">
                    <span class="events-card-weekday">
                      {new Intl.DateTimeFormat("en-US", {
                        timeZone: "America/Chicago",
                        weekday: "short"
                      }).format(new Date(ev.start))}
                    </span>
                    <span class="events-card-day">
                      {new Intl.DateTimeFormat("en-US", {
                        timeZone: "America/Chicago",
                        day: "numeric"
                      }).format(new Date(ev.start))}
                    </span>
                    <span class="events-card-mon">
                      {new Intl.DateTimeFormat("en-US", {
                        timeZone: "America/Chicago",
                        month: "short"
                      }).format(new Date(ev.start))}
                    </span>
                  </div>
                  <div class="events-card-main">
                    <div class="events-card-head">
                      <h2 class="events-card-title">{ev.title}</h2>
                      <p class="events-card-when">{formatEventRange(ev)}</p>
                    </div>
                    {ev.location && <p class="events-card-meta"><i class="fa-solid fa-location-dot" aria-hidden="true" /> {ev.location}</p>}
                    {excerpt(ev.description) && (
                      <p class="events-card-desc">{excerpt(ev.description)}</p>
                    )}
                  </div>
                  <span class="events-card-accent-line" aria-hidden="true" />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section id="full-calendar" class="events-embed-band" aria-labelledby="embed-cal-heading">
      <div class="events-embed-inner">
        <h2 id="embed-cal-heading" class="events-embed-heading">Full church calendar</h2>
        <p class="events-embed-note">
          Prefer the web app?{' '}
          <a href={CHURCH_CALENDAR_WEB_URL} target="_blank" rel="noopener noreferrer">
            Open the public calendar at CCB →
          </a>
        </p>
        <EventsMonthCalendar events={allCalendarEvents} monthCount={2} />
      </div>
    </section>
  </div>

  <script is:inline>
    const rotator = document.querySelector(".events-hero [data-rotator]");
    if (rotator) {
      const slides = Array.from(rotator.querySelectorAll("[data-slide]"));
      const dots = Array.from(rotator.querySelectorAll("[data-dot]"));
      let activeIndex = 0;
      let timer;

      const showSlide = (index) => {
        activeIndex = index;
        slides.forEach((slide, i) => slide.classList.toggle("is-active", i === activeIndex));
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === activeIndex));
      };

      const startAutoplay = () => {
        if (slides.length < 2) return;
        timer = window.setInterval(() => {
          showSlide((activeIndex + 1) % slides.length);
        }, 5500);
      };

      const restartAutoplay = () => {
        if (timer) window.clearInterval(timer);
        startAutoplay();
      };

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          showSlide(index);
          restartAutoplay();
        });
      });

      startAutoplay();
    }
  </script>
</BaseLayout>
